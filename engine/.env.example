# Salin ke engine/.env lalu isi. File .env tidak pernah di-commit.

# local = laptop tim (job collect diproses); public = server juri (job collect ditolak)
APP_MODE=local

# Koneksi sebagai radar_engine: hanya baca/tulis data, tidak bisa mengubah tabel
RADAR_DB_HOST=127.0.0.1
RADAR_DB_PORT=5432
RADAR_DB_NAME=radar_narasi
RADAR_DB_USER=radar_engine
RADAR_DB_PASSWORD=

# Kunci HMAC pseudonimisasi (dipakai mulai tahap adapter data). Minimal 32 karakter acak.
# Buat dengan: openssl rand -hex 32
PSEUDO_KEY=

# Sumber data. API key YouTube Data API v3 dari Google Cloud Console (gratis, 10.000 unit/hari).
# Batasi key hanya untuk YouTube Data API v3. Jangan pernah di-commit.
YOUTUBE_API_KEY=
# Belum dipakai: data X, Instagram, dan TikTok diimpor dari file ekspor Apify (paket gratis tidak bisa lewat API).
APIFY_TOKEN=

# Simpan nama tampilan akun dan @username (bukan ID/URL) untuk kasus data nyata, agar admin dan
# analis bisa melihatnya. Hanya berlaku di APP_MODE=local; server publik tidak pernah menyimpannya.
# Isi false untuk mematikan. Pasangan di web/.env: RADAR_SHOW_ACCOUNT_NAMES.
RADAR_STORE_ACCOUNT_NAMES=true

# Batas jumlah post per kasus (bawaan 20000). Isi nilai yang sama di web/.env.
# Memori analisis tumbuh kira-kira kuadratik: 10.000 post sekitar 1,6 GB, 20.000 sekitar 3 GB.
RADAR_MAX_ITEMS=20000

# Folder file unggahan CSV Laravel (disk local): <kartika-app>/web/storage/app/private
RADAR_UPLOAD_DIR=../web/storage/app/private

# Opsional
WORKER_POLL_SECONDS=3
